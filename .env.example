# Optional: `docker compose up` works without a .env, using the defaults
# below (the same values are the defaults in docker-compose.yml). Copy to .env
# (git-ignored) to change them, e.g. if any port is ever exposed beyond this
# machine. Change POSTGRES_PASSWORD before the first `docker compose up`: the
# database keeps the password it was created with.
POSTGRES_USER=adaptive_lb
POSTGRES_PASSWORD=adaptive_lb_dev
POSTGRES_DB=adaptive_lb
# Host side of the connection (scripts and tests run on your machine).
# 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Required on requests that change things: the LB admin API (switch strategy,
# add/remove backends) and the backends' fault injection. The dashboard sends it.
ADMIN_TOKEN=dev-admin-token
